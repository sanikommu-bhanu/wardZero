# Copy to .env.local for a production build (npm run build) pointed at a deployed API.
# In dev (npm run dev) these are unused — vite.config.ts proxies /api and /ws to
# WZ_API_PROXY_TARGET (defaults to http://localhost:8000) instead.
VITE_API_BASE_URL=https://your-deployed-api.example.com
VITE_WS_URL=wss://your-deployed-api.example.com/ws
