# Copy to .env — never commit .env
WZ_ENV=development
WZ_DATABASE_URL=sqlite:///./wardzero.db
# PostgreSQL: postgresql+psycopg://user:pass@localhost:5432/wardzero
WZ_JWT_SECRET=change-me-to-a-long-random-string
WZ_JWT_EXPIRE_MINUTES=60
WZ_ACK_TIMEOUT_SECONDS=300
WZ_MODEL_DIR=ml/artifacts
WZ_ADMIN_EMAIL=admin@wardzero.local
WZ_ADMIN_PASSWORD=change-me-on-first-run
WZ_API_URL=http://127.0.0.1:8000
# Comma-separated browser origins allowed to call the API (only needed if the frontend is hosted separately)
WZ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Free alert channels (optional; in-app alerts always work without these) ---
# Telegram: create a bot with @BotFather, send it a message, then read your chat id from /getUpdates
WZ_TELEGRAM_BOT_TOKEN=
WZ_TELEGRAM_CHAT_ID=
# ntfy.sh push: pick an unguessable topic name and subscribe to it in the ntfy app
WZ_NTFY_TOPIC=
WZ_NTFY_SERVER=https://ntfy.sh
